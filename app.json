{
  "expo": {
    "name": "BAKEN",
    "slug": "baken",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo 3.png",
    "scheme": "finalprojectapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Logo 3.png"
      },
      "package": "com.baken.baken"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/Logo 3.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/butterfly-wild.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "ac93be51-edb4-4328-8d59-de726989a418"
      }
    }
  }
}
