{
  "expo": {
    "name": "BAKEN",
    "slug": "baken",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/Profiel.png",
    "scheme": "finalprojectapp",
    "userInterfaceStyle": "automatic",
    
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/Profiel.png"
      },
      "package": "com.baken.baken"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/Profiel.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/butterfly-wild.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    
  }
}
